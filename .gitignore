# ---- Vivado journals, logs, and scratch ----
*.jou
*.log
*.str
*.os
*.backup.jou
*.backup.log
*.backup.zip
.Xil/
.hsreplay
vivado*.zip
vivado*.debug
webtalk*.xml
webtalk*.html
NA/

# ---- Vivado generated output directories ----
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.sdk/

# ---- Block design generated products ----
# Keep the .bd source file; everything under the bd/<name>/ subdirs is
# regenerated by Vivado (output products, wrapper hdl, packaged IP copies).
*.srcs/sources_1/bd/*/hdl/
*.srcs/sources_1/bd/*/hw_handoff/
*.srcs/sources_1/bd/*/ip/
*.srcs/sources_1/bd/*/ipshared/
*.srcs/sources_1/bd/*/sim/
*.srcs/sources_1/bd/*/synth/
*.srcs/sources_1/bd/*/ui/
*.srcs/sources_1/bd/*/*.bxml
*.srcs/sources_1/bd/mref/

# ---- Xilinx SDK workspace (sdk/) ----
# Eclipse workspace metadata - machine-local, regenerated on open
sdk/.metadata/
sdk/SDK.log
sdk/webtalk/
sdk/RemoteSystemsTempFiles/

# Build outputs (regenerated by make / SDK build)
**/Debug/
**/Release/
*.elf
*.elf.size
*.elf.check
*.o
*.d
*.a
*.su

# NOTE: PS_app_bsp is kept in version control even though parts are
# generated - lwipopts.h was hand-patched (CONFIG_LINKSPEED100,
# MEMP_NUM_TCP_SEG 1024) and BSP regeneration does not reliably
# re-apply those settings.

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store
